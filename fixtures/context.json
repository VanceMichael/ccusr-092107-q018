  "interventions": [
    {
      "id": "iv-customs-tie",
      "heritage_point_id": "hp-customs-01",
      "title": "北墙裂缝注浆与拉杆加固",
      "based_on_refs": ["ar-customs-northwall#3"],
      "model_id": "m3d-customs-02",
      "water_environment": {
        "upstream_point_ids": [],
        "downstream_point_ids": ["hp-guild-01", "hp-sluice-01"],
        "assessment": "注浆与拉杆作业在岸上关楼内完成，不改变河道过水断面，下游闸、馆水位无叠加影响，仍同步观测一个汛期"
      },
      "opening_arrangement": {
        "affected_point_ids": ["hp-customs-01"],
        "arrangement": "施工期北墙展区封闭、其余院落分时开放，完工后按开放条件版本恢复"
      },
      "decision": {
        "factors": [
          {"factor": "专家争用", "detail": "结构专家主张注浆，砖作专家担心浆液改变原砖含水率，经会商采用低收缩匹配砂浆"},
          {"factor": "预算争用", "detail": "与水工遗址汛前支顶同批申报，本项非紧急，排期让位于先处置项目，分两期拨付"},
          {"factor": "上下游影响", "detail": "不进入河道，对下游会馆、闸址水位与流态无影响，仅做汛期同步观测"},
          {"factor": "三维模型换版", "detail": "审查采用现行m3d-customs-02（v2），旧v1模型留存但禁止作为决策依据"},
          {"factor": "居民隐私", "detail": "施工区无住户，不涉及居民信息采集"},
          {"factor": "游客量变化", "detail": "分时开放预计旺季客流下降约一成，以线上导览补偿"}
        ],
        "outcome": "批准",
        "decided_date": "2026-04-02",
        "decided_by": "省文物保护审查组（虚构机构）"
      }
    },
    {
      "id": "iv-sluice-brace",
      "heritage_point_id": "hp-sluice-01",
      "title": "北岸闸墩汛前紧急钢支撑",
      "based_on_refs": ["ar-sluice-pier#3"],
      "model_id": null,
      "water_environment": {
        "upstream_point_ids": ["hp-customs-01", "hp-guild-01"],
        "downstream_point_ids": ["hp-town-01"],
        "assessment": "临时支墩占用水侧约1.2米，要求汛后拆除；已通知上游两点关注壅水、下游古镇关注水巷流速变化"
      },
      "opening_arrangement": {
        "affected_point_ids": ["hp-sluice-01", "hp-town-01"],
        "arrangement": "遗址观水平台临时封闭；下游古镇水上游线改道，码头分流"
      },
      "decision": {
        "factors": [
          {"factor": "专家争用", "detail": "抢险组一致同意钢支撑，对是否同时封底有分歧，按最小扰动先只支顶"},
          {"factor": "预算争用", "detail": "动用年度应急储备金，先于钞关常规修缮列支，事后补审决算"},
          {"factor": "上下游影响", "detail": "占用水侧断面影响过流，上游壅水、下游水巷流速变化均纳入监测通报"},
          {"factor": "三维模型换版", "detail": "险情紧急来不及建模，决策不引用三维模型，汛后补测并出模型再核销"},
          {"factor": "居民隐私", "detail": "作业区与水巷改道公告不出现住户门牌，拍摄视角避开民居院内"},
          {"factor": "游客量变化", "detail": "平台封闭使该点到访量短期下降，改道使古镇码头客流短时上升，需限流"}
        ],
        "outcome": "批准",
        "decided_date": "2026-02-22",
        "decided_by": "省文物保护审查组（虚构机构）"
      }
    }
